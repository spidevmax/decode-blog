{
	"name": "decode",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{js,jsx,css}\" \"e2e/*.mjs\" \"*.{js,json,html}\"",
		"format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"e2e/*.mjs\" \"*.{js,json,html}\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "node e2e/smoke.mjs",
		"e2e:flaky": "E2E_FAIL_RATE=0.08 node e2e/smoke.mjs"
	},
	"dependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.7.0",
		"jsdom": "^30.0.1",
		"playwright": "^1.62.0",
		"prettier": "^3.9.6",
		"vite": "^8.1.1",
		"vitest": "^4.1.10"
	}
}
